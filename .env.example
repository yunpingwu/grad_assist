# 大语言模型（阿里云百炼 OpenAI 兼容接口）
MODEL=deepseek-v4-flash
# 视觉模型（教材图片简介富化用）
VISUAL_MODEL=
ALIBABA_API_KEY=
ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# MinerU 文档解析服务
MINERU_API_KEY=
MINERU_BASE_URL=https://mineru.net

# Milvus 向量数据库
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=

# MinIO 对象存储
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=textbook-assets
MINIO_SECURE=false

# MongoDB（会话/对话历史存储）
MONGO_URI=mongodb://localhost:27017
MONGO_DB=grad_assist
MONGO_CHAT_COLLECTION=chat_sessions
MONGO_ACCESS_KEY=
MONGO_SECRET_KEY=

# 嵌入模型
# 留空时通过模型名称从模型服务或本地缓存加载
EMBEDDING_MODEL_PATH=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_DIM=1024

# 重排序模型（BGE-Reranker，本地路径优先；留空且模型名为 HF ID 时从模型服务加载）
RERANKER_MODEL_PATH=
RERANKER_MODEL=BAAI/bge-reranker-large
RERANKER_DEVICE=cpu
RERANKER_TOP_K=5

# 联网搜索（百炼 WebSearch MCP）
WEB_SEARCH_MCP_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp
WEB_SEARCH_TOOL=bailian_web_search
WEB_SEARCH_COUNT=3

# 日志
LOG_LEVEL=INFO
