# 大语言模型供应商选择：alibaba=阿里云百炼（默认）；deepseek=DeepSeek 官方平台
# 也可按调用点覆盖：get_llm_client(provider="deepseek")
LLM_PROVIDER=alibaba

# 阿里云百炼（LLM_PROVIDER=alibaba 时启用）
MODEL=deepseek-v4-flash
# 视觉模型（教材图片简介富化用）
VISUAL_MODEL=
ALIBABA_API_KEY=
ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DeepSeek 官方平台（LLM_PROVIDER=deepseek 时启用）
# 模型名为 deepseek-v4-pro / deepseek-v4-flash；思考模式平台侧默认开启（effort=high），
# agent 一轮几十次调用时思考是主要耗时/成本项，故这里默认关，按需再开
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_ENABLE_THINKING=false
DEEPSEEK_REASONING_EFFORT=high

# MinerU 文档解析服务
MINERU_API_KEY=
MINERU_BASE_URL=https://mineru.net

# Milvus 向量数据库
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=

# MinIO 对象存储
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=textbook-assets
MINIO_SECURE=false

# MongoDB（会话/对话历史存储）
MONGO_URI=mongodb://localhost:27017
MONGO_DB=grad_assist
MONGO_CHAT_COLLECTION=chat_sessions
MONGO_ACCESS_KEY=
MONGO_SECRET_KEY=

# 嵌入模型
# 留空时通过模型名称从模型服务或本地缓存加载
EMBEDDING_MODEL_PATH=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_DIM=1024

# 重排序模型（BGE-Reranker，本地路径优先；留空且模型名为 HF ID 时从模型服务加载）
RERANKER_MODEL_PATH=
RERANKER_MODEL=BAAI/bge-reranker-large
RERANKER_DEVICE=cpu
RERANKER_TOP_K=5

# 联网搜索（百炼 WebSearch MCP）
WEB_SEARCH_MCP_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp
WEB_SEARCH_TOOL=bailian_web_search
WEB_SEARCH_COUNT=3

# 会话成本预算护栏（per-session 加权 token 上限：未命中输入×1 + 命中输入×折扣 + 输出×权重）
# 超限即降级：禁 deep 检索、停澄清反问、提前收尾并说明；口径与标定见 app/trace/llm_usage.weighted_cost
BUDGET_ENABLED=true
BUDGET_LIMIT=1000000
BUDGET_CACHE_WEIGHT=0.2
BUDGET_OUTPUT_WEIGHT=4.0

# 日志
LOG_LEVEL=INFO
