# 本地环境变量和敏感信息
.env
.env.*
!.env.example

# Python 虚拟环境
.venv/
venv/
env/

# Python 缓存和编译文件
__pycache__/
*.py[cod]
*$py.class

# 测试、覆盖率和类型检查缓存
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.pyright/

# 构建和打包产物
build/
dist/
*.egg-info/
node_modules/
.npm-cache/

# IDE 和本地开发工具配置
.idea/
.vscode/
.trae/
.reasonix/

# 操作系统生成的文件
.DS_Store
Thumbs.db

# 本地教材及其解析产物
textbooks/

# 复习资料生成产物
study/

# RAG评估结果数据
/backend/data/

# 运行日志目录（*.log 已单独忽略，这里兜住目录本身）
/backend/logs/

# 容器部署时的模型挂载目录（默认 compose 路径）
/backend/models/

# Docker 本地数据卷与口令（compose 本体入库）
docker/*-data/
docker/.env

# LLM脚本
/backend/scripts/

# 运行日志和临时文件
*.log
*.tmp
*.temp

# pytest/pytorch 在仓库根目录留下的本地临时产物
pytest-of-*/
torchinductor_*/
